rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    function isAuth() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuth() && request.auth.uid == userId;
    }

    function isOwnerRole() {
      return isAuth() && request.auth.token != null && (
        request.auth.token.owner == true
        || request.auth.token.role == 'owner'
      );
    }

    function isAdmin() {
      return isOwnerRole() || (isAuth() && request.auth.token != null && (
        request.auth.token.admin == true
        || request.auth.token.role == 'admin'
      ));
    }

    function isValidImageContentType() {
      return request.resource.contentType in ['image/jpeg', 'image/png', 'image/webp'];
    }

    function isValidVideoContentType() {
      return request.resource.contentType in ['video/mp4', 'video/quicktime'];
    }

    function isAllowedMediaContentType() {
      return isValidImageContentType() || isValidVideoContentType();
    }

    function isOwnerBoundUpload() {
      return isAuth() &&
        request.resource.metadata.ownerUid is string &&
        request.resource.metadata.ownerUid == request.auth.uid;
    }

    function isValidUserOwnedFile(userId, maxBytes) {
      return isOwner(userId) &&
        isOwnerBoundUpload() &&
        request.resource.size <= maxBytes &&
        isAllowedMediaContentType();
    }

    function isValidPostUpload(postId, maxBytes) {
      return isAuth() &&
        isOwnerBoundUpload() &&
        request.resource.size <= maxBytes &&
        isAllowedMediaContentType() &&
        firestore.exists(/databases/default/documents/posts/$(postId)) &&
        firestore.get(/databases/default/documents/posts/$(postId)).data.authorId == request.auth.uid;
    }

    function isValidChatUpload(chatId, maxBytes) {
      return isAuth() &&
        isOwnerBoundUpload() &&
        request.resource.size <= maxBytes &&
        isAllowedMediaContentType() &&
        firestore.exists(/databases/(default)/documents/chats/$(chatId)) &&
        firestore.get(/databases/(default)/documents/chats/$(chatId)).data.keys().hasAny(['participants']) &&
        request.auth.uid in firestore.get(/databases/(default)/documents/chats/$(chatId)).data.participants;
    }

    match /users/{userId}/avatar.* {
      allow read: if isOwner(userId) || isAdmin();
      allow write: if isValidUserOwnedFile(userId, 2 * 1024 * 1024);
      allow delete: if isOwner(userId);
    }

    match /users/{userId}/stories/{storyId}/{fileName} {
      allow read: if isOwner(userId) || isAdmin();
      allow write: if isValidUserOwnedFile(userId, 25 * 1024 * 1024);
      allow delete: if isOwner(userId);
    }

    match /users/{userId}/{fileName} {
      allow read: if isOwner(userId) || isAdmin();
      allow write: if isValidUserOwnedFile(userId, 25 * 1024 * 1024);
      allow delete: if isOwner(userId);
    }

    match /users/{userId}/memories/{allPaths=**} {
      allow read: if isOwner(userId) || isAdmin();
      allow write: if isValidUserOwnedFile(userId, 25 * 1024 * 1024);
      allow delete: if isOwner(userId) || isAdmin();
    }

    match /posts/{postId}/{fileName} {
      allow read: if isAuth();
      allow write: if isValidPostUpload(postId, 25 * 1024 * 1024);
      allow delete: if isAuth() && resource.metadata.ownerUid == request.auth.uid;
    }

    match /chats/{chatId}/{fileName} {
      allow read: if isAuth() && firestore.exists(/databases/(default)/documents/chats/$(chatId)) && (
        firestore.get(/databases/(default)/documents/chats/$(chatId)).data.keys().hasAny(['participants'])
        && request.auth.uid in firestore.get(/databases/(default)/documents/chats/$(chatId)).data.participants
      );
      allow write: if isValidChatUpload(chatId, 25 * 1024 * 1024);
      allow delete: if isAuth() && resource.metadata.ownerUid == request.auth.uid;
    }

    match /site_assets/{allPaths=**} {
      allow read: if true;
      allow write: if isAdmin() && request.resource.size <= 10 * 1024 * 1024 && isAllowedMediaContentType();
    }

    match /{topLevel}/{allPaths=**} {
      allow read: if isAuth() && topLevel != 'chats';
      allow write: if false;
    }

    match /{fileName} {
      allow read: if isAuth();
      allow write: if false;
    }
  }
}
