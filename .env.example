# Firebase environment template for La Bomba
# Use real values only in the correct environment (DEV, STAGING, or PRODUCTION).
# Never commit real secrets to the repository.

FIREBASE_PROJECT_ID_DEV=your-dev-project-id
FIREBASE_PROJECT_ID_STAGING=your-staging-project-id
FIREBASE_PROJECT_ID_PROD=your-production-project-id

FIREBASE_API_KEY_DEV=replace-with-dev-api-key
FIREBASE_API_KEY_STAGING=replace-with-staging-api-key
FIREBASE_API_KEY_PROD=replace-with-production-api-key

FIREBASE_APP_ID_DEV=replace-with-dev-app-id
FIREBASE_APP_ID_STAGING=replace-with-staging-app-id
FIREBASE_APP_ID_PROD=replace-with-production-app-id

FIREBASE_AUTH_DOMAIN_DEV=your-dev-project-id.firebaseapp.com
FIREBASE_AUTH_DOMAIN_STAGING=your-staging-project-id.firebaseapp.com
FIREBASE_AUTH_DOMAIN_PROD=your-production-project-id.firebaseapp.com

FIREBASE_STORAGE_BUCKET_DEV=your-dev-project-id.firebasestorage.app
FIREBASE_STORAGE_BUCKET_STAGING=your-staging-project-id.firebasestorage.app
FIREBASE_STORAGE_BUCKET_PROD=your-production-project-id.firebasestorage.app

FIREBASE_MESSAGING_SENDER_ID_DEV=000000000000
FIREBASE_MESSAGING_SENDER_ID_STAGING=000000000000
FIREBASE_MESSAGING_SENDER_ID_PROD=000000000000

ADMIN_WHITELIST_DEV=dev-admin-users
ADMIN_WHITELIST_STAGING=staging-admin-users
ADMIN_WHITELIST_PROD=production-admin-users

GOOGLE_CLIENT_ID_DEV=replace-with-dev-google-client-id
GOOGLE_CLIENT_ID_STAGING=replace-with-staging-google-client-id
GOOGLE_CLIENT_ID_PROD=replace-with-production-google-client-id
